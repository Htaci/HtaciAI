<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.3.0</Version>
    <!-- 本项目的包版本自带（WebView2 不在宿主中央清单里）；契约/Avalonia 仍由宿主项目解析。 -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" />
    <!-- Avalonia 不在这里显式引用：契约程序集的 ProjectReference 已经把它带进来了。
         自己再加一条会引入第二份程序集身份，症状是「找不到 StackPanel」这种莫名其妙的错误。 -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HtaciAI.Plugin.Abstractions\HtaciAI.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 宿主用内存流加载插件程序集（Assembly.Location 为空），原生加载器得自己带、自己定址。 -->
    <None Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
          Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
