<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="140" d:DesignHeight="28"
             x:Class="HtaciAI.Controls.KnowledgeBaseSelectorControl">
    <!--
        知识库选择器（可复用控件）：
        按钮显示「书本图标 + 当前知识库名」，没选时显示「知识库」。
        与模型选择器同一个形态 —— 都是「当前值直接写在按钮上」，不再只给一个图标。
        菜单第一项是「不指定」（这个会话不查知识库），其后是全部知识库。
    -->
    <UserControl.Styles>
        <Style Selector="Button#KbBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F1F3F5"/>
        </Style>
        <Style Selector="Button#KbBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#E5E7EB"/>
        </Style>
    </UserControl.Styles>

    <Button x:Name="KbBtn"
            MinWidth="80"
            Height="28"
            Padding="8,0"
            CornerRadius="8"
            Background="Transparent">
        <Button.Flyout>
            <MenuFlyout/>
        </Button.Flyout>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText"
                       Text="&#xF8FE;"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="14"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="LabelText"
                       Text="知识库"
                       FontSize="12"
                       MaxWidth="120"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
</UserControl>
