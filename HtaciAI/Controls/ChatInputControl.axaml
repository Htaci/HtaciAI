<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="140"
             x:Class="HtaciAI.Controls.ChatInputControl"
             ClipToBounds="False">

    <!--
        会话输入区（输入框 + 工具栏 + 提示行）。

        抽成控件的原因：新建页与对话页各手搓过一份，于是「附件」这个能力只加在了后者身上，
        新建页的上传按钮甚至是个没接处理程序的死按钮。同一件事有两份实现，就一定会只改一份。

        本控件**不认识**自己在哪个页面。会话相关的差异一律由宿主用可选输入表达：
          * 草稿持久化 —— DraftStore 可空，为空就是不落库（新建页还没有会话可挂）
          * 运行态 —— 由宿主调 SetRunning；新建页不调，于是「停止」形态永远不出现
          * 用量环 —— SetContextUsage 传 null 即隐藏（新建页没有历史可算）
          * 更多菜单 —— 项由宿主注入（「压缩上下文」需要历史，新建页不注入）
        这样控件里没有一处「如果是新建页就……」的分支。

        根元素上的 ClipToBounds="False" 不能去掉：输入框的聚焦高亮是往外散 7px 的
        BoxShadow，而 InputShell 撑满了本控件的宽度，光晕左右两侧与上边都落在控件边界之外。
        UserControl 默认裁剪，高亮就只剩内边可见 —— 看起来就是「高亮被遮了一半」。
        宿主请在控件外留出余量（对话页给了 Margin="15"，新建页在 Spacing="20" 的
        StackPanel 里），光晕才有地方散。
    -->

    <UserControl.Styles>
        <!-- 静止态的边框色必须写在这里，不能写成 Border 上的 BorderBrush="…"。

             Avalonia 的优先级是「本地值 > 带伪类的样式」，本地值一旦设了就再也改不动 ——
             下面 :focus-within 里那条 BorderBrush 会永远是死的（表现为聚焦时只有光晕变色、
             贴边那一圈仍是灰的）。同理 Background 也放在样式里，保持一致。

             静止态的 BoxShadow 同样必须显式写出来，且必须与聚焦态<b>同层数</b>（都是两层），
             只是颜色 alpha=0（不可见）：过渡动画要对两端逐层插值，一边是空列表时
             长度对不上，就只能整体突变 —— 那正是「边光是秒出现秒消失」的来历。 -->
        <Style Selector="Border#InputShell">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BoxShadow" Value="0 0 0 1 #007EB3E8, 0 0 7 2 #007EB3E8"/>
        </Style>

        <!-- 聚焦态画在外层 Border 上：边缘阴影。
             0 0 0 1 是贴着边框的一圈实边（叠上自身 1px 边框共 2px），
             0 0 7 2 是往外散的柔光，两层叠出「细边 + 光晕」。
             光晕只能这么画 —— BorderBrush 画在框内，做不出往外的发光。

             过渡参数与「创建新会话」按钮的悬停阴影一致（300 ms + CubicEaseOut），
             两处动效的手感才是同一个。 -->
        <Style Selector="Border#InputShell:focus-within">
            <Setter Property="BorderBrush" Value="#7EB3E8"/>
            <Setter Property="BoxShadow" Value="0 0 0 1 #7EB3E8, 0 0 7 2 #4D7EB3E8"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- 附件没有单独的一栏：卡片就在正文里（见下面 ChatInputEditor 的说明）。
             早先是正文上方一条 chip 栏，附件跟正文的位置关系在那里是断的 ——
             用户看到的顺序和发出去的顺序并不一定一致。 -->

        <!-- Background / BorderBrush 故意不写在这里：见上面样式区的说明，
             写成属性会让聚焦态的 setter 失效。 -->
        <Border x:Name="InputShell"
                CornerRadius="8"
                BorderThickness="1"
                MinHeight="100">
            <!-- 聚焦/失焦时边框色与光晕都走过渡，不再是一次性跳变。
                 挂在元素上而不是写在样式里：Transitions 不是被样式切来切去的值，
                 它是「怎么过渡」的规则，放在这里一眼能对上下面那两个 setter。 -->
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="BorderBrush"
                                     Duration="0:0:0.3"
                                     Easing="CubicEaseOut"/>
                    <!-- 两层阴影逐层插值（0 0 0 1 的贴边实边 + 0 0 7 2 的柔光） -->
                    <BoxShadowsTransition Property="BoxShadow"
                                          Duration="0:0:0.3"
                                          Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <Grid>
                <!-- 正文里每个 U+FFFC 占位字符都会被画成一张附件卡片（见 ChatInputEditor），
                     所以粘贴文件之后，正文位置上看到的就是消息气泡里那种卡片本身，
                     而不是 `@图片1` 这样的文字。 -->
                <controls:ChatInputEditor x:Name="InputBox"
                                          MinHeight="100"
                                          MaxHeight="200"/>

                <!-- 功能栏 -->
                <Grid VerticalAlignment="Bottom" Background="Transparent">
                    <!-- 右半边用 StackPanel 而非各自 Right 定位：某个环隐藏时（IsVisible=false
                         不占布局）右边的控件要自然补上空档。顺序：模型选择器 → 等待环 → 用量环 → 发送 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Margin="0,5,5,5">
                        <controls:ModelSelectorControl x:Name="ModelPicker" VerticalAlignment="Center"/>
                        <!-- 已发出请求、还没收到任何输出时的等待指示 -->
                        <controls:LoadingRing x:Name="LoadingRing" VerticalAlignment="Center"/>
                        <controls:ContextUsageRing x:Name="UsageRing" VerticalAlignment="Center"/>
                        <Button x:Name="SendBtn"
                                Width="28"
                                Height="28"
                                Padding="0"
                                CornerRadius="8"
                                Background="#4A90D9"
                                Click="OnSendClick">
                            <Grid>
                                <TextBlock x:Name="SendGlyph"
                                           Text="&#xF19C;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <!-- 运行中：换成停止方块 -->
                                <Border x:Name="StopGlyph"
                                        Width="10"
                                        Height="10"
                                        CornerRadius="2.5"
                                        Background="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="False"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <!-- 上传文件：以绝对路径插入正文，由 read / view_image 工具读取 -->
                        <Button x:Name="AddFileBtn"
                                Width="28"
                                Height="28"
                                Padding="0"
                                CornerRadius="8"
                                Background="Transparent"
                                Margin="5"
                                Click="OnAddFileClick">
                            <TextBlock Text="&#xF1AA;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <controls:ToolSelectorControl x:Name="ToolPicker" Margin="5"/>
                        <controls:SkillSelectorControl x:Name="SkillPicker" Margin="5"/>
                        <controls:McpSelectorControl x:Name="McpPicker" Margin="5"/>
                        <!-- 知识库：这个会话查哪个库。按钮上直接写库名，与模型选择器同一形态 -->
                        <controls:KnowledgeBaseSelectorControl x:Name="KbPicker" Margin="5"/>
                        <!-- 权限模式（严格/普通/宽松/自由）：文字写在按钮上，不再只给一个图标 -->
                        <Button x:Name="PermModeBtn"
                                Height="28"
                                Padding="8,0"
                                CornerRadius="8"
                                Background="Transparent"
                                Margin="5">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="严格（所有工具需确认）" Tag="Strict"/>
                                    <MenuItem Header="普通（安全工具自动）" Tag="Normal"/>
                                    <MenuItem Header="宽松（安全/风险自动）" Tag="Loose"/>
                                    <MenuItem Header="自由（所有工具免确认）" Tag="Free"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PermModeIcon"
                                           Text="&#xF6BF;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14"
                                           Margin="0,0,6,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="PermModeLabel"
                                           Text="普通"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- 更多功能（菜单项由宿主注入：Flyout 里的 x:Name 不生成字段） -->
                        <Button x:Name="MoreBtn"
                                Width="28"
                                Height="28"
                                Padding="0"
                                CornerRadius="8"
                                Background="Transparent"
                                Margin="5">
                            <TextBlock Text="&#xE825;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <!-- 插件工具栏（插槽 conversation.input.toolbar）：内建按钮右边，用一条竖线隔开。
                             插件没往这个插槽里放东西时，分隔线与整块一起隐藏 ——
                             留一条空的分隔线会让人以为输入框坏了。 -->
                        <Border x:Name="PluginToolbarDivider"
                                Width="1"
                                Height="14"
                                Margin="4,0"
                                CornerRadius="0.5"
                                Background="#E5E7EB"
                                VerticalAlignment="Center"
                                IsVisible="False"/>
                        <StackPanel x:Name="PluginToolbarSlot"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    IsVisible="False"/>
                        <!-- 状态提示：压缩进度、模型未配置这类需要在输入框边上说的话。
                             要发一次模型请求的操作（压缩）没有提示会让人以为卡住了。 -->
                        <TextBlock x:Name="HintText"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   IsVisible="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
