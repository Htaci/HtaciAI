<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="28" d:DesignHeight="28"
             x:Class="HtaciAI.Controls.McpSelectorControl">
    <!--
        MCP 服务选择器（可复用控件）：
        按钮显示 MCP 图标 + 已选数量角标，点击弹出菜单逐个勾选要启用的服务。
        图标与新标签页的「MCP服务」卡片一致（Segoe Fluent Icons U+E8AF）。
        服务列表由外部注入，选中结果通过 SelectedServerIds（TwoWay）暴露。
    -->
    <Button x:Name="RootBtn"
            Width="28"
            Height="28"
            Padding="0"
            CornerRadius="8"
            Background="Transparent">
        <Button.Flyout>
            <MenuFlyout/>
        </Button.Flyout>
        <ToolTip.Tip>
            <TextBlock Text="MCP 服务"/>
        </ToolTip.Tip>
        <Grid>
            <TextBlock x:Name="IconText"
                       Text="&#xe8af;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Border x:Name="Badge"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    MinWidth="14"
                    Height="14"
                    CornerRadius="7"
                    Background="#7B5EA7"
                    IsVisible="False"
                    Margin="0,2,2,0"
                    Padding="3,0">
                <TextBlock x:Name="BadgeText"
                           Text="0"
                           FontSize="9"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Button>
</UserControl>
