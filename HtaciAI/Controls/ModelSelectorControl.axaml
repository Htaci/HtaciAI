<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="180" d:DesignHeight="28"
             x:Class="HtaciAI.Controls.ModelSelectorControl">
    <!--
        模型选择器（可复用控件）：
        按钮本体显示「模型图标 + 当前模型名 + · + 当前思考模式」，
        点击弹出菜单：模型列表（动态）→ 分隔线 → 思考模式子菜单。
        模型列表由外部通过 Models 属性注入（数据库加载），内置默认模型兜底；
        思考模式选项固定为 NoThink/none/low/high/max。
    -->
    <Button x:Name="ModelAndThinkBtn"
            MinWidth="100"
            Height="28"
            Padding="0"
            CornerRadius="8"
            Background="Transparent">
        <Button.Flyout>
            <MenuFlyout/>
        </Button.Flyout>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xf158;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="14"
                       Margin="5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="ModelLabel"
                       Text=""
                       FontSize="12"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
            <TextBlock Text="·"
                       FontSize="12"
                       Margin="5,0,5,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="ThinkingLabel"
                       Text="none"
                       FontSize="12"
                       Margin="0,0,10,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
</UserControl>
