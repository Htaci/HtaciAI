<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="60"
             x:Class="HtaciAI.Controls.TurnActivityCard">
    <UserControl.Styles>
        <!-- 卡片内容区专用：极细灰色滚动条（4px，圆角滑块） -->
        <Style Selector=".thin-scrollbar ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="4" Background="Transparent">
                            <Rectangle Fill="Transparent"/>
                            <!-- Value 必须双向，且必须用 {TemplateBinding} 而不是
                                 {Binding RelativeSource={RelativeSource TemplatedParent}}：
                                 TemplateBindingExpression 的优先级是 Template，回写走 SetCurrentValue，
                                 不会顶掉 ScrollBar 自己那条 Template 优先级的 Offset→Value 绑定。
                                 少了 Mode=TwoWay，拖滑块时 Track.Value 传不回 ScrollBar.Value ——
                                 现象就是「滑块能拖，但内容一动不动」。
                                 其余属性照抄 Avalonia Fluent 的 ScrollBar 模板。 -->
                            <Track Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseButton>
                                    <RepeatButton IsTabStop="False" Focusable="False"
                                                  Opacity="0" Width="0" Height="0"/>
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton IsTabStop="False" Focusable="False"
                                                  Opacity="0" Width="0" Height="0"/>
                                </Track.IncreaseButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28" IsTabStop="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#D8D8DC" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 悬停滑块加深，提示可拖拽 -->
        <Style Selector=".thin-scrollbar ScrollBar /template/ Thumb:pointerover /template/ Border">
            <Setter Property="Background" Value="#A6A6AD"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="Card"
            CornerRadius="10"
            Background="#00F7F8FA"
            BorderBrush="#ECEEF1"
            BorderThickness="1"
            ClipToBounds="True">
        <StackPanel>
            <!-- 头：汇总 + 展开箭头 -->
            <Border x:Name="Header"
                    Height="46"
                    Background="Transparent"
                    CornerRadius="10"
                    Cursor="Hand">
                <Grid ColumnDefinitions="*,Auto" Margin="18,0,18,0">
                    <TextBlock x:Name="HeaderText"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#1F1F1F"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="Chevron"
                               Grid.Column="1"
                               Text="›"
                               FontSize="16"
                               Foreground="#C5C5C7"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 内容区：可展开的步骤序列 -->
            <controls:SmoothScrollViewer x:Name="ContentScroll"
                          Classes="thin-scrollbar"
                          MaxHeight="0"
                          Opacity="0"
                          Margin="18,0,18,0">
                <StackPanel x:Name="ContentPanel" Spacing="6" Margin="0,4,0,4"/>
            </controls:SmoothScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
