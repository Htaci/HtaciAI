<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HtaciAI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="760"
        x:Class="HtaciAI.Views.CreateWorkspaceWindow"
        Icon="/Assets/logo.ico"
        Title="创建新工作空间"
        Width="560" MinWidth="560" MaxWidth="560"
        Height="760" MinHeight="760"
        Background="#F7F8FA"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True"/>
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="40"/>
            <Setter Property="WindowDecorations" Value="BorderOnly"/>
            <Setter Property="CanResize" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent" Opacity="1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 标题 -->
        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   Text="创建新工作空间"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1A1A2E"
                   Margin="24,18,24,6"/>

        <!-- 表单 -->
        <controls:SmoothScrollViewer Grid.Row="1"
                      Margin="24,8,24,8"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <!-- 名称 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="工作空间名称"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="NameBox"
                             Height="34"
                             Padding="10,0"
                             CornerRadius="6"
                             PlaceholderText="未设置时默认为工作目录名称"/>
                </StackPanel>

                <!-- 描述 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="描述"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="DescBox"
                             Height="34"
                             Padding="10,0"
                             CornerRadius="6"/>
                </StackPanel>

                <!-- 工作目录 -->
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="工作目录"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="AddFolderBtn"
                                Grid.Column="1"
                                Height="28"
                                CornerRadius="6"
                                Background="#546E7A"
                                Foreground="White"
                                Padding="12,0"
                                Cursor="Hand"
                                Click="OnAddFolderClick">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xe710;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="11"/>
                                <TextBlock Text="选择" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBox x:Name="PathBox"
                             Height="34"
                             Padding="10,0"
                             CornerRadius="6"
                             IsReadOnly="True"
                             PlaceholderText="选择项目根目录"/>
                </StackPanel>

                <!-- 默认工具 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="默认工具"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <Border CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="10,8">
                        <controls:SmoothScrollViewer MaxHeight="110"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ToolsHost" Spacing="4"/>
                        </controls:SmoothScrollViewer>
                    </Border>
                </StackPanel>

                <!-- 默认技能 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="默认技能"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <Border CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="10,8">
                        <controls:SmoothScrollViewer MaxHeight="110"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SkillsHost" Spacing="4"/>
                        </controls:SmoothScrollViewer>
                    </Border>
                </StackPanel>

                <!-- MCP -->
                <StackPanel Spacing="6">
                    <TextBlock Text="MCP 服务器 id（每行一个，预留）"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="McpBox"
                             MinHeight="54"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Padding="10,8"
                             CornerRadius="6"
                             FontFamily="Consolas"/>
                </StackPanel>

                <!-- 系统提示词 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="系统提示词（描述工作区是干什么的）"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="SystemPromptBox"
                             MinHeight="70"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Padding="10,8"
                             CornerRadius="6"/>
                </StackPanel>

                <!-- 默认权限模式 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="默认权限模式"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <ComboBox x:Name="PermissionCombo"
                              Height="34"
                              CornerRadius="6"/>
                    <TextBlock x:Name="PermissionHint"
                               FontSize="11"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </controls:SmoothScrollViewer>

        <!-- 底部按钮 -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="24,8,24,18">
            <Button Grid.Column="1"
                    Height="34"
                    Padding="20,0"
                    CornerRadius="8"
                    Background="#E5E7EB"
                    Foreground="#374151"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Click="OnCancelClick">
                <TextBlock Text="取消" FontSize="13"/>
            </Button>
            <Button Grid.Column="2"
                    Height="34"
                    Padding="20,0"
                    CornerRadius="8"
                    Background="#546E7A"
                    Foreground="White"
                    Cursor="Hand"
                    Click="OnCreateClick">
                <TextBlock x:Name="SubmitText" Text="创建" FontSize="13"/>
            </Button>
        </Grid>
    </Grid>
</Window>
