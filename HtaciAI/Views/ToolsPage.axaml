<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="HtaciAI.Views.ToolsPage">
    <Grid ColumnDefinitions="280,*">
        <!-- ====== 左侧：工具集列表 ====== -->
        <Border Grid.Column="0"
                Background="#99F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*"
                  Margin="12,16">
                <!-- 标题 + 新建工具集 -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto">
                    <TextBlock Text="工具集"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"
                               VerticalAlignment="Center"
                               Margin="12,0,0,12"/>
                    <Border x:Name="AddToolsetBtn"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            CornerRadius="8"
                            Background="Transparent"
                            Margin="0,0,4,8"
                            Cursor="Arrow">
                        <TextBlock Text="&#xF10A;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="#1A1A2E"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 工具集列表 -->
                <controls:SmoothScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ToolsetList"
                                Spacing="2"/>
                </controls:SmoothScrollViewer>
            </Grid>
        </Border>

        <!-- ====== 右侧：工具列表 ====== -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              Margin="24,20">
            <!-- 顶部：标题 + 添加工具 + 创建新工具 -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto,Auto"
                  Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="PanelTitle"
                               Text="工具"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1A1A2E"/>
                    <TextBlock x:Name="PanelDesc"
                               Text="管理工具与工具集，为 AI 提供可调用的能力"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,4,0,0"/>
                    <!-- 开发文档：点一次才生成到 <数据根>/doc/ 并用浏览器打开。
                         三类扩展共用同一份文档，这里落到「工具」那一类（含两个可直接跑的示例脚本）。 -->
                    <TextBlock x:Name="DevDocLink"
                               Text="工具开发文档 · 脚本工具怎么写"
                               FontSize="11.5"
                               Foreground="#7C8AA0"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               Margin="0,6,0,0"
                               ToolTip.Tip="生成到数据目录的 doc 文件夹，并用浏览器打开（含 Python / Node.js 两个示例）"/>
                </StackPanel>

                <!-- 把其他集合里的工具加进当前集合 -->
                <Border x:Name="AddToolBtn"
                        Grid.Column="1"
                        Height="36"
                        CornerRadius="18"
                        Background="Transparent"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="16,0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Cursor="Arrow">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xF10A;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Foreground="#4B5563"/>
                        <TextBlock Text="添加工具"
                                   FontSize="13"
                                   Foreground="#4B5563"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CreateToolBtn"
                        Grid.Column="2"
                        Height="36"
                        CornerRadius="18"
                        Background="#1A1A2E"
                        Padding="16,0"
                        VerticalAlignment="Center"
                        Cursor="Arrow">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xF10A;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="创建新工具"
                                   FontSize="13"
                                   Foreground="#FFFFFF"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 工具列表 -->
            <ContentControl x:Name="ToolListHost"
                            Grid.Row="1"/>
        </Grid>
    </Grid>
</UserControl>
