<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HtaciAI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="600"
        x:Class="HtaciAI.Views.Tools.AddToolsWindow"
        Icon="/Assets/logo.ico"
        Title="添加工具"
        Width="520" MinWidth="520" MaxWidth="520"
        Height="600" MinHeight="600"
        Background="#F7F8FA"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True"/>
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="40"/>
            <Setter Property="WindowDecorations" Value="BorderOnly"/>
            <Setter Property="CanResize" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent" Opacity="1"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="添加工具"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1A1A2E"
                   Margin="24,18,24,6"/>

        <TextBlock x:Name="SubtitleText"
                   Grid.Row="1"
                   FontSize="12"
                   Foreground="#9CA3AF"
                   TextWrapping="Wrap"
                   Margin="24,0,24,10"/>

        <controls:SmoothScrollViewer Grid.Row="2"
                      Margin="24,0,24,8"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ToolPanel" Spacing="4"/>
        </controls:SmoothScrollViewer>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto,Auto"
              Margin="24,8,24,18">
            <Button Grid.Column="1"
                    Height="34"
                    Padding="20,0"
                    CornerRadius="8"
                    Background="#E5E7EB"
                    Foreground="#374151"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Click="OnCancelClick">
                <TextBlock Text="取消" FontSize="13"/>
            </Button>
            <Button Grid.Column="2"
                    Height="34"
                    Padding="20,0"
                    CornerRadius="8"
                    Background="#546E7A"
                    Foreground="White"
                    Cursor="Hand"
                    Click="OnSaveClick">
                <TextBlock Text="添加" FontSize="13"/>
            </Button>
        </Grid>
    </Grid>
</Window>
