<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:HtaciAI.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="HtaciAI.Views.ConversationView">
    <!-- 细滚动条样式统一在 App.axaml 的 .thin-scrollbar 里（导航列表 / 卡片内容区共用）。
         输入框的聚焦视觉（盖掉 Fluent 模板里的 2px 蓝边、外层描边发光）已随输入区一起搬进
         Controls/ChatInputControl.axaml，在那里改才对 —— 本文件已经不再拥有输入框。 -->

    <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">
        <!-- ====== 顶部插槽（插件可往这里放一行内容；没内容时整行隐藏） ====== -->
        <StackPanel x:Name="HeaderSlot"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="34,12,34,0"
                    IsVisible="False"/>
        <!-- ====== 消息列表 ====== -->
        <controls:SmoothScrollViewer x:Name="MessagesScroll"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <!-- 透明背景：消息之间的空白也参与命中测试，保证滚动/悬停行为连续 -->
            <StackPanel x:Name="MessagesPanel" Spacing="12" Margin="34,20" Background="Transparent"/>
        </controls:SmoothScrollViewer>

        <!-- ====== 输入区 ======
             附件栏 / 输入框 / 工具栏 / 提示行都在 Controls/ChatInputControl 里，
             与「新建会话」页共用同一份实现。会话相关的差异由代码后置注入：
             DraftStore（草稿落库）、SetRunning（运行态）、SetContextUsage（用量环）、
             AddMoreItem（压缩上下文）—— 控件本身不知道自己在哪个页面。 -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*">
            <!-- 输入区左侧插槽（插件可放一排小按钮；没内容时整列隐藏） -->
            <StackPanel x:Name="InputSideSlot"
                        Grid.Column="0"
                        Orientation="Vertical"
                        Spacing="6"
                        Margin="15,15,0,15"
                        VerticalAlignment="Bottom"
                        IsVisible="False"/>

            <controls:ChatInputControl x:Name="Input"
                                       Grid.Column="1"
                                       Margin="15"
                                       VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</UserControl>
