<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="550"
             x:Class="HtaciAI.Views.NewChatView">
    <!-- 输入框的聚焦视觉已随输入区搬进 Controls/ChatInputControl.axaml。
         本页原先为了「和对话页保持一致」复制过一份，那种复制正是两页分叉的起点。 -->

    <Grid x:Name="FullRoot" Background="Transparent" PointerPressed="OnBackgroundPressed">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Background="Transparent">
        <StackPanel Spacing="20">
            <TextBlock Text="有什么我可以帮助你的？"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#1A1A2E"
                       HorizontalAlignment="Center"/>

            <!-- 目标分类：普通会话 / 工作空间。轨道半透明，选中项是白色胶囊。
                 这里用 Border + PointerPressed 而不是 Button：Button 的模板会在
                 :pointerover 时往自己的 ContentPresenter 上叠一层灰，本地值覆盖不掉，
                 而这一行不需要悬停高亮（白色胶囊本身已经表示选中）。 -->
            <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Border HorizontalAlignment="Center"
                        CornerRadius="18"
                        Background="#0F000000"
                        Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ModePlainBtn"
                                Width="96" Height="28"
                                CornerRadius="14"
                                Background="#FFFFFF"
                                Cursor="Hand">
                            <TextBlock x:Name="ModePlainText"
                                       Text="普通会话"
                                       FontSize="13"
                                       Foreground="#1A1A2E"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ModeWorkspaceBtn"
                                Width="96" Height="28"
                                CornerRadius="14"
                                Background="Transparent"
                                Cursor="Hand">
                            <TextBlock x:Name="ModeWorkspaceText"
                                       Text="工作空间"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- 输入区：与对话页共用同一个控件。
                 附件（上传 / 拖入 / 粘贴截图）在这里就能用，不必先建会话。
                 会话相关的差异靠「不给」表达：不设 DraftStore（还没有会话可挂草稿）、
                 不调 SetRunning（本页不发请求）、不注入压缩菜单（没有历史可压）。 -->
            <controls:ChatInputControl x:Name="Input"/>

            <!-- 工作空间选择：只在工作空间模式下可用。
                 这里用 Opacity 而不是 IsVisible —— 外层是垂直居中的，控件一旦凭空
                 出现/消失，整块内容就会跟着上下挪，上面标题、分段、输入框的位置全变。
                 让这一行始终占位，切换时只是显示与隐藏，其他控件纹丝不动。 -->
            <StackPanel x:Name="WorkspaceSection"
                        Spacing="10"
                        Opacity="0"
                        IsHitTestVisible="False">
                <controls:WorkspacePickerControl x:Name="WorkspacePicker"/>
                <TextBlock Text="选择一个工作空间，开始一段有上下文的对话"
                           FontSize="12"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
