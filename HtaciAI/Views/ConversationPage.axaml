<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="HtaciAI.Views.ConversationPage">
    <!-- 细滚动条样式统一在 App.axaml 的 .thin-scrollbar 里（导航列表 / 卡片内容区共用）。 -->

    <Border BorderBrush="LightGray"
            BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="280,*,Auto">
            <!-- ====== 左侧导航：工作空间（树形）+ 普通对话 ====== -->
            <Border Grid.Column="0"
                    Background="#99F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto"
                      Margin="12,16">

                    <!-- 创建新对话按钮（胶囊形 + 悬停阴影过渡） -->
                    <Grid Grid.Row="0">
                        <Border x:Name="NewChatShadow"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                CornerRadius="20"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                Opacity="0"
                                BoxShadow="0 8 24 0 #14000000, 0 4 8 0 #0A000000"/>
                        <Border x:Name="NewChatBtn"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                CornerRadius="20"
                                Background="#FFFFFF"
                                Cursor="Hand"
                                BoxShadow="0 1 3 0 #0A000000, 0 1 2 0 #06000000">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xF10A;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="创建新会话"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 导航列表（分组标题 / 工作空间树 / 普通对话，全部由 C# 构建） -->
                    <controls:SmoothScrollViewer Grid.Row="1"
                                                 Classes="thin-scrollbar"
                                                 Margin="0,14,0,0"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavList" Spacing="2"/>
                    </controls:SmoothScrollViewer>

                    <!-- 左侧导航底部插槽（插件可在这里放状态面板；没内容时整行隐藏） -->
                    <StackPanel x:Name="SidebarBelowSlot"
                                Grid.Row="2"
                                Spacing="6"
                                Margin="0,12,0,0"
                                IsVisible="False"/>
                </Grid>
            </Border>

            <!-- ====== 右侧内容区域 ====== -->
            <ContentControl x:Name="RightPanel"
                            Grid.Column="1"
                            Background="#99FFFFFF"/>

            <!-- 会话页右侧插槽（插件可在这里放「与当前会话并排看」的内容；没内容时整列隐藏） -->
            <Border x:Name="RightSidebarSlot"
                    Grid.Column="2"
                    Background="#99FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <StackPanel x:Name="RightSidebarSlotPanel"
                            Spacing="8"
                            Margin="12"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
