<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="HtaciAI.Views.McpPage">
    <Grid ColumnDefinitions="280,*">
        <!-- ====== 左侧：MCP 服务列表 ====== -->
        <Border Grid.Column="0"
                Background="#99F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*"
                  Margin="12,16">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="12,0,8,12">
                    <TextBlock Grid.Column="0"
                               Text="MCP 服务"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"
                               VerticalAlignment="Center"/>
                    <Button x:Name="AddServerButton"
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            ToolTip.Tip="新增 MCP 服务">
                        <TextBlock Text="&#xe710;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   Foreground="#4B5563"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <controls:SmoothScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ServerList"
                                Spacing="2"/>
                </controls:SmoothScrollViewer>
            </Grid>
        </Border>

        <!-- ====== 右侧：服务详情 + 分类标签 ====== -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*"
              Margin="24,20">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,14">
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="DetailTitle"
                               Text="MCP 服务"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1A1A2E"/>
                    <TextBlock x:Name="DetailDesc"
                               Text="选择左侧服务查看详情"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 启动状态 + 启动/停止按钮（代码生成） -->
                <StackPanel x:Name="HeaderActions"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Top"
                            Margin="12,2,0,0"/>
            </Grid>

            <!-- 分类标签（自绘，项目无 TabControl） -->
            <StackPanel x:Name="TabBar"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,0,14"/>

            <ContentControl x:Name="TabHost"
                            Grid.Row="2"/>
        </Grid>
    </Grid>
</UserControl>
