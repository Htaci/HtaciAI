<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="HtaciAI.Views.WorkspacePage">
    <Grid ColumnDefinitions="300,*">
        <!-- ====== 左侧：工作空间导航 ====== -->
        <Border Grid.Column="0"
                Background="#99F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*"
                  Margin="12,14">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- 创建新工作空间 -->
                    <Border x:Name="CreateWorkspaceBtn"
                            Grid.Column="0"
                            Height="36"
                            CornerRadius="8"
                            Background="Transparent"
                            Cursor="Arrow"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,8,0"
                            IsVisible="True">
                        <TextBlock Text="+ 新建工作空间"
                                   FontSize="14"
                                   Foreground="#1A1A2E"
                                   VerticalAlignment="Center"
                                   Margin="12,0"/>
                    </Border>
                    <!-- 新建会话 -->
                    <Border x:Name="NewSessionBtn"
                            Grid.Column="0"
                            Height="36"
                            CornerRadius="8"
                            Background="Transparent"
                            Cursor="Arrow"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,8,0"
                            IsVisible="False">
                        <TextBlock x:Name="NewSessionText"
                                   Text="+ 新建会话"
                                   FontSize="14"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   Margin="12,0"/>
                    </Border>
                    <!-- 搜索 -->
                    <Border x:Name="SearchBtn"
                            Grid.Column="1"
                            Height="36"
                            Width="36"
                            CornerRadius="8"
                            Background="Transparent"
                            Cursor="Arrow"
                            HorizontalAlignment="Right">
                        <TextBlock Text="&#xe71e;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   Foreground="#1A1A2E"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 列表区域：工作空间列表 / 会话列表 -->
                <ContentControl x:Name="ListHost"
                                Grid.Row="3"/>
            </Grid>
        </Border>

        <!-- ====== 右侧：工作对话内容区 ====== -->
        <ContentControl x:Name="RightPanel"
                        Grid.Column="1"
                        Background="#99FFFFFF"/>
    </Grid>
</UserControl>
