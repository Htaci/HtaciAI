<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="HtaciAI.Views.AgentsPage">
    <Grid ColumnDefinitions="280,*">
        <!-- ====== 左侧：Agent 列表 ====== -->
        <Border Grid.Column="0"
                Background="#99F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*"
                  Margin="12,16">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="ListTitle"
                               Text="子 Agent"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"
                               VerticalAlignment="Center"
                               Margin="12,0,0,12"/>
                    <Border x:Name="AddAgentBtn"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            CornerRadius="8"
                            Background="Transparent"
                            Margin="0,0,4,8"
                            Cursor="Arrow">
                        <TextBlock Text="&#xF10A;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="#1A1A2E"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <controls:SmoothScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AgentList"
                                Spacing="2"/>
                </controls:SmoothScrollViewer>
            </Grid>
        </Border>

        <!-- ====== 右侧：Agent 配置表单 ====== -->
        <Grid x:Name="ConfigRoot"
              Grid.Column="1"
              RowDefinitions="Auto,*"
              Margin="24,20"
              IsVisible="False">
            <!-- 顶部：标题 + 操作按钮 -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="DetailTitle"
                               Text="子 Agent 配置"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1A1A2E"/>
                    <TextBlock x:Name="DetailDesc"
                               Text="主 Agent 用 task 工具按名字派发，子 Agent 只回一份报告"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Border x:Name="EditBtn"
                            Height="36"
                            CornerRadius="18"
                            Background="#1A1A2E"
                            Padding="16,0"
                            VerticalAlignment="Center"
                            Cursor="Arrow">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xF3DE;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13"
                                       Foreground="#FFFFFF"/>
                            <TextBlock Text="编辑"
                                       FontSize="13"
                                       Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DeleteBtn"
                            Height="36"
                            CornerRadius="18"
                            Background="#FEE2E2"
                            Padding="16,0"
                            VerticalAlignment="Center"
                            Cursor="Arrow"
                            IsVisible="False">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xF34D;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13"
                                       Foreground="#DC2626"/>
                            <TextBlock Text="删除"
                                       FontSize="13"
                                       Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="SaveBtn"
                            Height="36"
                            CornerRadius="18"
                            Background="#1A1A2E"
                            Padding="16,0"
                            VerticalAlignment="Center"
                            Cursor="Arrow"
                            IsVisible="False">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xF680;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13"
                                       Foreground="#FFFFFF"/>
                            <TextBlock Text="保存"
                                       FontSize="13"
                                       Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CancelBtn"
                            Height="36"
                            CornerRadius="18"
                            Background="#F3F4F6"
                            Padding="16,0"
                            VerticalAlignment="Center"
                            Cursor="Arrow"
                            IsVisible="False">
                        <TextBlock Text="取消"
                                   FontSize="13"
                                   Foreground="#374151"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <controls:SmoothScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16"
                            Margin="0,0,24,24">
                    <!-- 名称 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="名称"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <TextBox x:Name="NameBox"
                                 CornerRadius="8"
                                 FontSize="14"
                                 Padding="12,10"
                                 BorderBrush="#E5E7EB"/>
                    </StackPanel>
                    <!-- 描述 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="描述"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <TextBox x:Name="DescBox"
                                 CornerRadius="8"
                                 FontSize="14"
                                 Padding="12,10"
                                 BorderBrush="#E5E7EB"/>
                    </StackPanel>
                    <!-- 角色默认配置：只在角色模式可见。会话创建时继承，之后仍可在会话里改。 -->
                    <StackPanel x:Name="RoleDefaultsPanel"
                                Spacing="16"
                                IsVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock Text="默认模型（新会话用这个模型）"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                            <ComboBox x:Name="ModelCombo"
                                      Height="34"
                                      CornerRadius="6"/>
                            <TextBlock Text="不指定时，新会话用「上次使用的模型」"
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="默认知识库（新会话默认挂这个库）"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                            <ComboBox x:Name="KbCombo"
                                      Height="34"
                                      CornerRadius="6"/>
                            <TextBlock Text="不指定时不给新会话挂知识库，发送时仍可临时选"
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 系统提示词 -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="PromptLabel"
                                   Text="系统提示词（这个子 Agent 的角色与输出要求，派发时注入它的会话）"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <TextBox x:Name="PromptBox"
                                 CornerRadius="8"
                                 FontSize="13"
                                 Padding="12,10"
                                 BorderBrush="#E5E7EB"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="200"
                                 FontFamily="Consolas"/>
                    </StackPanel>
                    <!-- 默认启用的工具 -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ToolsLabel"
                                   Text="可用工具（留空 = 继承父会话全部；实际范围还要与父会话取交集，task 永远剔除）"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <Border CornerRadius="10"
                                Background="#FFFFFF"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Padding="12,10">
                            <controls:SmoothScrollViewer MaxHeight="160"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ToolsHost"
                                            Spacing="6"/>
                            </controls:SmoothScrollViewer>
                        </Border>
                    </StackPanel>
                    <!-- 默认启用的技能 -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SkillsLabel"
                                   Text="可用技能（留空 = 继承父会话允许的全部；技能全文不会被复制进子会话）"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <Border CornerRadius="10"
                                Background="#FFFFFF"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Padding="12,10">
                            <controls:SmoothScrollViewer MaxHeight="160"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SkillsHost"
                                            Spacing="6"/>
                            </controls:SmoothScrollViewer>
                        </Border>
                    </StackPanel>
                    <!-- MCP -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="McpLabel"
                                   Text="MCP 服务器 id（每行一个，留空 = 继承父会话；只会收窄不会放开）"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <TextBox x:Name="McpBox"
                                 CornerRadius="8"
                                 FontSize="13"
                                 Padding="12,10"
                                 BorderBrush="#E5E7EB"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 FontFamily="Consolas"/>
                    </StackPanel>
                </StackPanel>
            </controls:SmoothScrollViewer>
        </Grid>
    </Grid>
</UserControl>
