<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="HtaciAI.Views.PluginsPage">
    <Grid ColumnDefinitions="280,*">
        <!-- ====== 左侧：插件列表 ====== -->
        <Border Grid.Column="0"
                Background="#99F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*"
                  Margin="12,16">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="12,0,8,12">
                    <TextBlock Grid.Column="0"
                               Text="插件"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"
                               VerticalAlignment="Center"/>
                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            ToolTip.Tip="重新扫描插件目录">
                        <TextBlock Text="&#xF13E;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="#4B5563"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <controls:SmoothScrollViewer Grid.Row="1"
                                             HorizontalScrollBarVisibility="Disabled"
                                             VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PluginList"
                                Spacing="2"/>
                </controls:SmoothScrollViewer>
            </Grid>
        </Border>

        <!-- ====== 右侧：总开关 + 所选插件详情 ====== -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              Margin="24,20">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,16">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="插件"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1A1A2E"/>
                    <TextBlock x:Name="HeaderDesc"
                               Text="加载第三方扩展，按它们声明的能力生效"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>

                    <!-- 插件开发文档：小字提示，点了才生成到 <数据根>/doc/ 并用浏览器打开。
                         不点就不占磁盘，也不会在启动时多出几个文件。 -->
                    <TextBlock x:Name="DevDocLink"
                               Text="插件开发文档 · 从零写一个插件"
                               FontSize="11.5"
                               Foreground="#7C8AA0"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               Margin="0,6,0,0"
                               ToolTip.Tip="生成到数据目录的 doc 文件夹，并用浏览器打开（含在 VS 里建 dll 项目的步骤）"/>
                </StackPanel>

                <Border x:Name="OpenDirectoryButton"
                        Grid.Column="1"
                        Height="36"
                        CornerRadius="18"
                        Background="Transparent"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="16,0"
                        VerticalAlignment="Top"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xF42F;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Foreground="#4B5563"/>
                        <TextBlock Text="打开插件目录"
                                   FontSize="13"
                                   Foreground="#4B5563"/>
                    </StackPanel>
                </Border>
            </Grid>

            <controls:SmoothScrollViewer Grid.Row="1"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel"
                            Spacing="12"/>
            </controls:SmoothScrollViewer>
        </Grid>
    </Grid>
</UserControl>
