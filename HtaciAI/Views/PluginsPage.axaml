<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="HtaciAI.Views.PluginsPage">
    <Grid ColumnDefinitions="280,*">
        <!-- ====== 左侧：插件列表 ====== -->
        <Border Grid.Column="0"
                Background="#99F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*"
                  Margin="12,16">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto,Auto"
                      Margin="12,0,8,12">
                    <TextBlock Grid.Column="0"
                               Text="插件"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"
                               VerticalAlignment="Center"/>

                    <!-- 主页：插件卡片总览（默认页）。点插件详情后可以用它回到这里 -->
                    <Button x:Name="HomeButton"
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            ToolTip.Tip="插件主页">
                        <TextBlock Text="&#xF481;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="#4B5563"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            ToolTip.Tip="重新扫描插件目录">
                        <TextBlock Text="&#xF13E;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="#4B5563"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <controls:SmoothScrollViewer Grid.Row="1"
                                             HorizontalScrollBarVisibility="Disabled"
                                             VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PluginList"
                                Spacing="2"/>
                </controls:SmoothScrollViewer>
            </Grid>
        </Border>

        <!-- ====== 右侧：主页（插件卡片）或所选插件的详情 ====== -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              Margin="24,20">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,16">
                <StackPanel Grid.Column="0">
                    <!-- 主页时是「插件」，进某个插件后换成它的名字 -->
                    <TextBlock x:Name="HeaderTitle"
                               Text="插件"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1A1A2E"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeaderDesc"
                               Text="加载第三方扩展，按它们声明的能力生效"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>

                    <!-- 详情页：这个插件声明的能力（就放在原来「开发文档」那行的位置） -->
                    <WrapPanel x:Name="HeaderCaps"
                               Orientation="Horizontal"
                               Margin="0,8,0,0"
                               IsVisible="False"/>

                    <!-- 详情页的分页切换：介绍（README）/ 工具（这个插件登记给宿主的工具） -->
                    <StackPanel x:Name="DetailTabs"
                                Orientation="Horizontal"
                                Spacing="18"
                                Margin="0,12,0,0"
                                IsVisible="False"/>

                    <!-- 插件开发文档：小字提示，点了才生成到 <数据根>/doc/ 并用浏览器打开。
                         不点就不占磁盘，也不会在启动时多出几个文件。只在主页显示。 -->
                    <TextBlock x:Name="DevDocLink"
                               Text="插件开发文档 · 从零写一个插件"
                               FontSize="11.5"
                               Foreground="#7C8AA0"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               Margin="0,6,0,0"
                               ToolTip.Tip="生成到数据目录的 doc 文件夹，并用浏览器打开（含在 VS 里建 dll 项目的步骤）"/>
                </StackPanel>

                <StackPanel x:Name="HeaderActions"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Top">
                    <!-- 详情页右上角：自动加载 + 启用（开关形式，代码里按选中项重建） -->
                    <StackPanel x:Name="DetailActions"
                                Orientation="Horizontal"
                                Spacing="18"
                                VerticalAlignment="Center"
                                IsVisible="False"/>

                    <Border x:Name="OpenDirectoryButton"
                            Height="36"
                            CornerRadius="18"
                            Background="Transparent"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="16,0"
                            VerticalAlignment="Top"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xF42F;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13"
                                       Foreground="#4B5563"/>
                            <TextBlock Text="打开插件目录"
                                       FontSize="13"
                                       Foreground="#4B5563"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <controls:SmoothScrollViewer Grid.Row="1"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel"
                            Spacing="12"/>
            </controls:SmoothScrollViewer>
        </Grid>
    </Grid>
</UserControl>
