<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="HtaciAI.ChatPage">
    <Grid ColumnDefinitions="260,*">
        <!-- ====== 左侧导航栏 ====== -->
        <Border Grid.Column="0"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*"
                  Margin="12,16">

                <!-- 创建新会话按钮（胶囊形 + 悬停阴影过渡） -->
                <Grid Grid.Row="0">
                    <!-- 阴影层（悬停时淡入） -->
                    <Border x:Name="NewChatShadow"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            CornerRadius="20"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            Opacity="0"
                            BoxShadow="0 8 24 0 #14000000, 0 4 8 0 #0A000000"/>
                    <!-- 按钮主体 -->
                    <Border x:Name="NewChatBtn"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            CornerRadius="20"
                            Background="#FFFFFF"
                            BoxShadow="0 1 3 0 #0A000000, 0 1 2 0 #06000000">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xe710;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="创建新会话"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 历史记录标题 -->
                <TextBlock Grid.Row="1"
                           Text="历史记录"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#9CA3AF"
                           Margin="12,20,0,10"/>

                <!-- 历史记录列表 -->
                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HistoryList"
                                Spacing="2"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ====== 右侧聊天区域 ====== -->
        <Border Grid.Column="1" Background="#FFFFFF">
            <TextBlock Text="选择一个会话开始聊天"
                       Foreground="#9CA3AF"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
