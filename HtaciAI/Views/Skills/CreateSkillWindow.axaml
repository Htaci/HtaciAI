<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HtaciAI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="700"
        x:Class="HtaciAI.Views.Skills.CreateSkillWindow"
        Icon="/Assets/logo.ico"
        Title="创建新技能"
        Width="560" MinWidth="560" MaxWidth="560"
        Height="700" MinHeight="700"
        Background="#F7F8FA"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True"/>
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="40"/>
            <Setter Property="WindowDecorations" Value="BorderOnly"/>
            <Setter Property="CanResize" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent" Opacity="1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="创建新技能"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1A1A2E"
                   Margin="24,18,24,6"/>

        <controls:SmoothScrollViewer Grid.Row="1"
                      Margin="24,8,24,8"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <!-- 技能 id（目录名） -->
                <StackPanel Spacing="6">
                    <TextBlock Text="技能 id"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="IdBox"
                             Height="34"
                             Padding="10,0"
                             CornerRadius="6"
                             PlaceholderText="如：code-review（小写字母/数字/-/_，作为目录名）"/>
                    <TextBlock Text="保存到 &lt;数据根&gt;\skills\&lt;id&gt;\SKILL.md，创建后不可改名。"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 名称 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="技能名（name）"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="NameBox"
                             Height="34"
                             Padding="10,0"
                             CornerRadius="6"
                             PlaceholderText="留空则与技能 id 相同"/>
                    <TextBlock Text="AI 通过 load_skill 按这个名字加载，建议与 id 一致。"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 备注名 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="备注名（alias，可空）"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="AliasBox"
                             Height="34"
                             Padding="10,0"
                             CornerRadius="6"
                             PlaceholderText="界面上显示的中文名，如：代码审查"/>
                </StackPanel>

                <!-- 描述 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="描述"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="DescBox"
                             MinHeight="56"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Padding="10,8"
                             CornerRadius="6"
                             PlaceholderText="一句话说明这个技能做什么、AI 何时该用它"/>
                </StackPanel>

                <!-- 正文 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="正文（SKILL.md）"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="BodyBox"
                             MinHeight="220"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Padding="10,8"
                             CornerRadius="6"
                             FontFamily="Consolas"
                             PlaceholderText="加载该技能时全文注入 system 提示词，用 Markdown 写清楚步骤与要求"/>
                </StackPanel>

                <!-- 提示/错误 -->
                <TextBlock x:Name="ErrorText"
                           FontSize="12"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </controls:SmoothScrollViewer>

        <!-- 底部按钮 -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="24,8,24,18">
            <Button Grid.Column="1"
                    Height="34"
                    Padding="20,0"
                    CornerRadius="8"
                    Background="#E5E7EB"
                    Foreground="#374151"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Click="OnCancelClick">
                <TextBlock Text="取消" FontSize="13"/>
            </Button>
            <Button Grid.Column="2"
                    Height="34"
                    Padding="20,0"
                    CornerRadius="8"
                    Background="#546E7A"
                    Foreground="White"
                    Cursor="Hand"
                    Click="OnSaveClick">
                <TextBlock Text="保存" FontSize="13"/>
            </Button>
        </Grid>
    </Grid>
</Window>
