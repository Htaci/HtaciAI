<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="HtaciAI.Views.TasksPage">
    <Grid ColumnDefinitions="300,*">
        <!-- ====== 左侧：任务列表 ====== -->
        <Border Grid.Column="0"
                Background="#99F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*" Margin="12,16">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="定时任务"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"
                               VerticalAlignment="Center"
                               Margin="12,0,0,12"/>
                    <Border x:Name="AddTaskBtn"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            CornerRadius="8"
                            Background="Transparent"
                            Margin="0,0,4,8"
                            Cursor="Arrow">
                        <TextBlock Text="+"
                                   FontSize="18"
                                   Foreground="#1A1A2E"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <controls:SmoothScrollViewer Grid.Row="1"
                                             HorizontalScrollBarVisibility="Disabled"
                                             VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TaskList" Spacing="2"/>
                </controls:SmoothScrollViewer>
            </Grid>
        </Border>

        <!-- ====== 右侧：任务编辑 ====== -->
        <ScrollViewer x:Name="EditorScroll"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="False">
            <StackPanel Margin="24,20" Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock x:Name="EditorTitle"
                                   Text="定时任务"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1A1A2E"/>
                        <TextBlock x:Name="EditorSub"
                                   Text="到点自动跑一轮 Agent 对话，结果留在运行历史里"
                                   FontSize="12"
                                   Foreground="#9CA3AF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border x:Name="RunNowBtn"
                                Height="36"
                                CornerRadius="18"
                                Background="#F1F3F5"
                                Padding="16,0"
                                VerticalAlignment="Center"
                                Cursor="Arrow">
                            <TextBlock Text="立即运行" FontSize="13" Foreground="#1A1A2E"/>
                        </Border>
                        <Border x:Name="SaveBtn"
                                Height="36"
                                CornerRadius="18"
                                Background="#1A1A2E"
                                Padding="16,0"
                                VerticalAlignment="Center"
                                Cursor="Arrow">
                            <TextBlock Text="保存" FontSize="13" Foreground="#FFFFFF"/>
                        </Border>
                        <Border x:Name="DeleteBtn"
                                Height="36"
                                CornerRadius="18"
                                Background="#FEE2E2"
                                Padding="16,0"
                                VerticalAlignment="Center"
                                Cursor="Arrow">
                            <TextBlock Text="删除" FontSize="13" Foreground="#DC2626"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 标题 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="标题" FontSize="12" Foreground="#6B7280"/>
                    <TextBox x:Name="TitleBox" PlaceholderText="例如：每日项目备份"/>
                </StackPanel>

                <!-- 提示词 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="提示词（每次触发发给模型的那条消息）" FontSize="12" Foreground="#6B7280"/>
                    <TextBox x:Name="PromptBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="140"
                             PlaceholderText="要到点做的事，写全：没有人在旁边补充说明。"/>
                </StackPanel>

                <!-- 触发规则 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="触发规则" FontSize="12" Foreground="#6B7280"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="KindBox" Width="110"/>
                        <TextBox x:Name="TimeBox" Width="110" PlaceholderText="HH:mm:ss"/>
                        <TextBox x:Name="DaysBox" Width="180" PlaceholderText="每月几号：1,15,31"/>
                        <TextBox x:Name="OnceBox" Width="220" PlaceholderText="一次：yyyy-MM-dd HH:mm:ss"/>
                    </StackPanel>
                    <WrapPanel x:Name="WeekdayPanel"/>
                    <TextBlock x:Name="RuleHint"
                               FontSize="12"
                               Foreground="#9CA3AF"/>
                </StackPanel>

                <!-- 模型 / 权限 / 轮次 / 目录 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="模型" FontSize="12" Foreground="#6B7280"/>
                    <ComboBox x:Name="ModelBox" Width="280"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="权限档位" FontSize="12" Foreground="#6B7280"/>
                        <ComboBox x:Name="PermissionBox" Width="140"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="轮次上限" FontSize="12" Foreground="#6B7280"/>
                        <TextBox x:Name="MaxTurnsBox" Width="90"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="工作目录" FontSize="12" Foreground="#6B7280"/>
                        <TextBox x:Name="BaseDirBox" Width="320" PlaceholderText="留空 = 进程当前目录"/>
                    </StackPanel>
                    <CheckBox x:Name="EnabledCheck"
                              Content="启用"
                              FontSize="13"
                              VerticalAlignment="Bottom"/>
                </StackPanel>

                <TextBlock x:Name="StatusLine"
                           FontSize="12"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"/>

                <TextBlock Text="运行历史"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1A1A2E"
                           Margin="0,8,0,0"/>
                <StackPanel x:Name="RunList" Spacing="6"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
