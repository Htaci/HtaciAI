<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:HtaciAI.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="HtaciAI.Views.WorkspaceChatView">
    <UserControl.Styles>
        <!-- 思考卡片内容区专用：极细的灰色滚动条（4px，圆角滑块） -->
        <Style Selector="ScrollViewer.thin-scrollbar ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="4">
                            <Rectangle Fill="Transparent"/>
                            <Track Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseButton>
                                    <RepeatButton IsTabStop="False" Focusable="False"
                                                  Opacity="0" Width="0" Height="0"/>
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton IsTabStop="False" Focusable="False"
                                                  Opacity="0" Width="0" Height="0"/>
                                </Track.IncreaseButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" IsTabStop="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#D0D0D3"
                                                        CornerRadius="2"
                                                        Margin="0,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="Transparent">
        <!-- ====== 消息列表 ====== -->
        <ScrollViewer x:Name="MessagesScroll"
                      Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <!-- 透明背景：让消息之间的空白也能命中，供 SelectionManager 处理空白按下起选 -->
            <StackPanel x:Name="MessagesPanel" Spacing="12" Margin="34,20" Background="Transparent"/>
        </ScrollViewer>

        <!-- ====== 输入区 ====== -->
        <Border Grid.Row="1"
                CornerRadius="8"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                MinHeight="100"
                Margin="15"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch">
            <Grid>
                <TextBox x:Name="InputBox"
                         MinHeight="100"
                         CornerRadius="8"
                         MaxHeight="200"
                         Padding="16,16,16,38"
                         FontSize="14"
                         Foreground="#1A1A2E"
                         PlaceholderText="在这里输入你的问题，Enter 发送，Shift+Enter 换行"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"/>

                <!-- 功能栏 -->
                <Grid VerticalAlignment="Bottom" Background="Transparent">
                    <controls:ModelSelectorControl x:Name="ModelSelector"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="5,5,40,5"/>
                    <Button x:Name="SendBtn"
                            HorizontalAlignment="Right"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="8"
                            Background="#4A90D9"
                            Margin="5"
                            Click="OnSendClick">
                        <TextBlock Text="&#xe74a;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <controls:ToolSelectorControl x:Name="ToolSelector" Margin="5"/>
                        <controls:SkillSelectorControl x:Name="SkillSelector" Margin="5"/>
                        <!-- 权限模式（严格/普通/宽松/自由） -->
                        <Button x:Name="PermModeBtn"
                                Width="28"
                                Height="28"
                                Padding="0"
                                CornerRadius="8"
                                Background="Transparent"
                                Margin="5">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="严格（所有工具需确认）" Tag="Strict"/>
                                    <MenuItem Header="普通（安全工具自动）" Tag="Normal"/>
                                    <MenuItem Header="宽松（安全/风险自动）" Tag="Loose"/>
                                    <MenuItem Header="自由（所有工具免确认）" Tag="Free"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <TextBlock x:Name="PermModeIcon"
                                       Text="&#xea18;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
