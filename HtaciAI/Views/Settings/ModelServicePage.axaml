<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="HtaciAI.Views.Settings.ModelServicePage">
    <!--
        本页只是个导航壳：具体内容（服务商卡片列表 / 服务商详情）全部在代码里构建并塞进 Host。
        之所以不在这里写两份 XAML 再切可见性：两边的结构差异很大（网格 vs 表格），
        用可见性切换会让「当前在哪一层」变得难以追踪，也让不相关的控件始终挂在可视树上。
    -->
    <Grid Background="Transparent">
        <ContentControl x:Name="Host"/>
    </Grid>
</UserControl>
