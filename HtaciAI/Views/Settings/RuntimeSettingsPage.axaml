<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="550"
             x:Class="HtaciAI.Views.Settings.RuntimeSettingsPage">
    <Grid Margin="28,24"
          RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Text="环境配置"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1A1A2E"/>
        <TextBlock Grid.Row="1"
                   Text="程序依赖的外部环境（脚本运行时、版本控制）与 AI 执行命令用的命令行工具。可自动检测系统 PATH，也可手动指定。"
                   FontSize="12"
                   Foreground="#9CA3AF"
                   Margin="0,6,0,20"
                   TextWrapping="Wrap"/>

        <!-- 运行时卡片列表（代码生成，便于未来扩展其他运行时） -->
        <controls:SmoothScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RuntimeList"
                        Spacing="14"/>
        </controls:SmoothScrollViewer>

        <!-- 底部说明 -->
        <Border Grid.Row="3"
                Margin="0,20,0,0"
                Padding="16,12"
                CornerRadius="10"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <TextBlock Text="当前支持：Python（.py）、Node.js（.js / .ts）、Git，bash 工具的执行器（cmd / Windows PowerShell / PowerShell 7 / Git Bash / bash），以及知识库用的本地嵌入模型。选中的 shell 会写进 bash 工具的介绍里，AI 据此决定命令怎么写。嵌入模型不进安装包，需要在这里单独下载（约 585 MB），装好之后向量库才能用；没有它知识库只剩下笔记与关键词检索。本页面可扩展更多环境。"
                       FontSize="12"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
