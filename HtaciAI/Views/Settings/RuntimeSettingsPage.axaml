<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HtaciAI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="550"
             x:Class="HtaciAI.Views.Settings.RuntimeSettingsPage">
    <Grid Margin="28,24"
          RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Text="环境配置"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1A1A2E"/>
        <TextBlock Grid.Row="1"
                   Text="程序依赖的外部环境（脚本运行时、版本控制）。可自动检测系统 PATH，也可手动指定。"
                   FontSize="12"
                   Foreground="#9CA3AF"
                   Margin="0,6,0,20"
                   TextWrapping="Wrap"/>

        <!-- 运行时卡片列表（代码生成，便于未来扩展其他运行时） -->
        <controls:SmoothScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RuntimeList"
                        Spacing="14"/>
        </controls:SmoothScrollViewer>

        <!-- 底部说明 -->
        <Border Grid.Row="3"
                Margin="0,20,0,0"
                Padding="16,12"
                CornerRadius="10"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <TextBlock Text="当前支持：Python（.py）、Node.js（.js / .ts）、Git。本页面可扩展更多环境。"
                       FontSize="12"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
